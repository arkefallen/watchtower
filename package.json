{
  "name": "watchtower",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "corepack pnpm test:unit && corepack pnpm test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "e2e": "playwright test",
    "verify": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test:unit && corepack pnpm test:integration",
    "db:migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@bull-board/api": "6.15.0",
    "@bull-board/express": "6.15.0",
    "@prisma/adapter-pg": "7.0.0",
    "@prisma/client": "7.0.0",
    "@tanstack/react-query": "5.90.5",
    "@trpc/client": "11.0.0",
    "@trpc/react-query": "11.0.0",
    "@trpc/server": "11.0.0",
    "bullmq": "5.58.5",
    "cytoscape": "^3.34.2",
    "cytoscape-fcose": "^2.2.0",
    "ioredis": "5.8.2",
    "next": "16.3.0",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "superjson": "2.2.2",
    "viem": "^2.56.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.6",
    "prisma": "7.0.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
